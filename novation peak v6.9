  local bankNum = parameterMap.get (deviceId, PT_VIRTUAL, 10032)
  local patchName = nameBank[bankNum][value]
  controls.get(CTRL_PATCH_NUMBER):setName(patchName)
  return (bankTxt[bankNum].." "..string.format("%03d",value))
end

-- ============================================================
-- Generic "dim group" helper
-- A "group" is a set of slots. Each slot has:
--   - one or more trigger param numbers (all of them == 0 -> dim)
--   - a list of control ids that get recolored together
--   - an on/off color pair (either per-slot or shared per-group)
-- ============================================================

local function makeDimGroup(def)
  -- def = {
  --   triggerParams = { {p1}, {p1,...} , ... }  -- one entry per slot; each entry is a list of param#s
  --   controlIds    = { {c1,c2,...}, ... }       -- one entry per slot; controls to recolor
  --   colors        = { {off=..,on=..}, ... } OR a single {off=..,on=..} shared by all slots
  -- }
  local group = { triggerParams = def.triggerParams, controlIds = def.controlIds, colors = def.colors }

  -- fast lookup: control id -> slot index (built from every control id in every slot)
  group.indexByCtrl = {}
  for i, ids in ipairs(group.controlIds) do
    for _, id in ipairs(ids) do
      group.indexByCtrl[id] = i
    end
  end

  function group:colorFor(i)
    if self.colors.off then
      return self.colors -- shared single color config
    end
    return self.colors[((i - 1) % #self.colors) + 1]
  end

  function group:update(i)
    local cfg = self:colorFor(i)
    if not cfg then return end

    local dim = true
    for _, p in ipairs(self.triggerParams[i]) do
      local v = parameterMap.get(deviceId, PT_VIRTUAL, p)
      if v == nil then return end -- not read yet; don't touch color
      if v ~= 0 then
        dim = false
        break
      end
    end

    local color = dim and cfg.off or cfg.on
    for _, ctrlId in ipairs(self.controlIds[i]) do
      local c = controls.get(ctrlId)
      if c then c:setColor(color) end
    end
  end

  function group:updateAll()
    for i = 1, #self.controlIds do self:update(i) end
  end

  function group:onCtrlChange(ctrlId)
    local i = self.indexByCtrl[ctrlId]
    if i then self:update(i) end
  end

  return group
end

