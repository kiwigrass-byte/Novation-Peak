-- ── Timer-based patch scanning ──────────────────────────────────────────────

-- State tracking for the patch scanner
local patchScanState = {
  bank = 1,           -- current bank (1-4)
  patch = 0,          -- current patch (0-127)
  isRunning = false,  -- scanner active flag
  scanTimer = nil     -- Timer object
}

-- Start the patch scanner (sends one request per second)
function startPatchScanner()
  if patchScanState.isRunning then
    print("Patch scanner already running")
    return
  end
  
  patchScanState.isRunning = true
  patchScanState.bank = 1
  patchScanState.patch = 0
  
  print("Starting patch scanner: 4 banks × 128 patches")
  
  -- Create Timer object and start repeating callback every 1000ms
  patchScanState.scanTimer = Timer()
  
  patchScanState.scanTimer:start(1000, function()
    -- Send the sysex request for current bank/patch
    midi.sendSysex(globalPort, concat(PEAK_SYSEX, {0x41, 0x00, 0x00, 0x00, patchScanState.bank, patchScanState.patch}))
    
    print(string.format("Requesting Bank %d, Patch %03d", patchScanState.bank, patchScanState.patch))
    
    -- Advance to next patch
    patchScanState.patch = patchScanState.patch + 1
    
    -- Check if we've reached the end of this bank
    if patchScanState.patch >= 128 then
      patchScanState.patch = 0
      patchScanState.bank = patchScanState.bank + 1
      
      -- Check if we've completed all 4 banks
      if patchScanState.bank > 4 then
        patchScanState.bank = 1  -- loop back to bank A
        print("Patch scanner cycle complete, restarting...")
      end
    end
  end, true)  -- true = repeating timer
end

-- Stop the patch scanner
function stopPatchScanner()
  if patchScanState.scanTimer then
    patchScanState.scanTimer:stop()
    patchScanState.scanTimer = nil
  end
  patchScanState.isRunning = false
  print("Patch scanner stopped")
end

-- Query current scanner status
function getPatchScannerStatus()
  if patchScanState.isRunning then
    return string.format("Running: Bank %d, Patch %03d", patchScanState.bank, patchScanState.patch)
  else
    return "Stopped"
  end
end
